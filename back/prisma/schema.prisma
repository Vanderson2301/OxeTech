generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Message {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  message  String
  readed Boolean @default(false)
  creatdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}